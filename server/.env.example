# ── Server environment variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resell?retryWrites=true&w=majority

# Port for the Express server (defaults to 5000 if not set)
PORT=5000

# Secret key used to sign JWT tokens — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Cloudinary credentials (required for image upload — Phase 3)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Maps Geocoding API key (server-side only, never sent to client — Phase 5)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Allowed origin for CORS (your Vite dev server or deployed frontend URL)
CLIENT_URL=http://localhost:5173
